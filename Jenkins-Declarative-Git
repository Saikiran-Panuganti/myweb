currentBuild.displayName="Java-service-#"+currentBuild.number
pipeline{
    agent any
    environment{
        PATH = "/opt/maven/bin:$PATH"
    }
    stages{
        stage("Git Checkout Java Project....!"){
            steps{
                echo "Repository checked out successfully."
                sh 'pwd'
                sh 'ls -lrt'
            }
        }
        stage("Maven Build"){
            steps{
                sh 'mvn clean package'
            }
        }

    }
}
