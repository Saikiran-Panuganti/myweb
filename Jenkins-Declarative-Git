currentBuild.displayName="Java-service-#"+currentBuild.number
pipeline{
    agent any
    environment{
        PATH = "/opt/maven/bin:$PATH"
    }
    stages{
        stage("Git Checkout Java Project....!"){
            steps{
                echo "Repository checked out successfully."
                sh 'pwd'
                sh 'ls -lrt'
            }
        }
        stage("Maven Build"){
            steps{
                sh 'mvn clean package -DskipTests'
                sh 'mv target/*.war target/myweb.war'
            }
        }
        stage("Deploy-dev."){
            steps{
                sshagent(['Tomcat-New']) {
                    sh '''
                        scp -o StrictHostKeyChecking=no target/myweb.war  ubuntu@172.31.18.153:/opt/tomcat/webapps/
                        ssh -o StrictHostKeyChecking=no ubuntu@172.31.18.153 "/opt/tomcat/bin/shutdown.sh"
                        ssh -o StrictHostKeyChecking=no ubuntu@172.31.18.153 "/opt/tomcat/bin/startup.sh"
                    '''
                }
            }
        }            
    }
}
